generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int            @id @default(autoincrement())
  email       String         @unique
  password    String
  first_name  String
  last_name   String
  phonenumber String
  supabase_id String? @unique
  documents   Document[]
}

model Document {
  id              Int        @id @default(autoincrement())
  document_name   String     @unique
  document_type   String
  document_size   Float
  file_path       String
  uploaded_at     DateTime   @default(now())
  user_id         Int
  user            User  @relation(fields: [user_id], references: [id])
}

