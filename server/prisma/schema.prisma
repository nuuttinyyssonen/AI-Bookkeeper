generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String         @id @default(uuid())
  email       String         @unique
  password    String
  first_name  String
  last_name   String
  phonenumber String
  supabase_id String? @unique
  documents   Document[]
  receipts    Receipt[]
}

model Document {
  id              String     @id @default(uuid())
  document_name   String     @unique
  document_type   String
  document_size   Float
  file_path       String
  status          DocumentStatus  @default(PENDING)
  upload_batch_id String?
  uploaded_at     DateTime   @default(now())
  user_id         String
  user            User  @relation(fields: [user_id], references: [id])
  receipts        Receipt[]
}

model Receipt {
  id              String       @id @default(uuid())
  document_id     String
  user_id         String
  vendor_name     String
  total_amount    Float
  receipt_date    DateTime
  receipt_type    ReceiptType @default(EXPENSE)
  created_at      DateTime    @default(now())
  user            User        @relation(fields: [user_id], references: [id])
  document        Document    @relation(fields: [document_id], references: [id])
  receiptVats     ReceiptVat[]
}

model ReceiptVat {
  id             String    @id @default(uuid())
  receipt_id     String
  rate           Float
  net_amount     Float
  vat_amount     Float
  total          Float
  receipt        Receipt  @relation(fields: [receipt_id], references: [id])
}

enum ReceiptType {
  INCOME
  EXPENSE
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}