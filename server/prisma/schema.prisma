generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  first_name          String
  last_name           String
  phonenumber         String
  supabase_id         String?              @unique
  documents           Document[]
  receipts            Receipt[]
  vatReports          VatReport[]
  chatrooms           ChatRoom[]
  subscription        Subscription[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  expires_at DateTime
  user       User     @relation(fields: [user_id], references: [id])
}

model Document {
  id              String     @id @default(uuid())
  document_name   String     @unique
  document_type   String
  document_size   Float
  file_path       String
  status          DocumentStatus  @default(PENDING)
  upload_batch_id String?
  uploaded_at     DateTime   @default(now())
  user_id         String
  user            User  @relation(fields: [user_id], references: [id])
  receipts        Receipt[]
}

model Receipt {
  id                            String      @id @default(uuid())
  document_id                   String
  user_id                       String
  category_id                   String?
  vendor_name                   String
  total_amount                  Float
  receipt_date                  DateTime
  receipt_type                  ReceiptType @default(EXPENSE)
  is_deductible                 Boolean     @default(true)
  vat_deductibility_percentage  Decimal     @default(100.0)   @db.Decimal(5, 2)
  created_at                    DateTime    @default(now())
  user                          User        @relation(fields: [user_id], references: [id])
  document                      Document    @relation(fields: [document_id], references: [id])
  category                      Category?   @relation(fields: [category_id], references: [id])
  receiptVats                   ReceiptVat[]
}

model Category {
  id       String       @id @default(uuid())
  type     CategoryType @unique
  label    String
  receipts Receipt[]
}

model ReceiptVat {
  id             String    @id @default(uuid())
  receipt_id     String
  rate           Float
  net_amount     Float
  vat_amount     Float
  total          Float
  receipt        Receipt  @relation(fields: [receipt_id], references: [id])
}

model VatReport {
  id                      String            @id @default(uuid())
  user_id                 String
  period_start            DateTime
  period_end              DateTime
  period_type             VatReportPeriod
  
  // Sales VAT (INCOME)
  sales_net               Decimal
  sales_vat_amount        Decimal
  sales_gross             Decimal

  // Purchase VAT (EXPENSE)
  purchase_net            Decimal
  purchase_vat_amount     Decimal
  purchase_gross          Decimal

  // Result
  vat_payable             Decimal           // sales_vat - purchase_vat (positiivinen = maksettava, negatiivinen = palautus)

  // VAT breakdown by rate
  vat_breakdown           Json              // tallentaa erittelyt JSON muodossa

  vat_declaration_sent    Boolean           @default(false)
  pdf_path                String?
  created_at              DateTime          @default(now())

  user                    User              @relation(fields: [user_id], references: [id])
}

model ChatRoom {
  id                      String            @id @default(uuid())
  title                   String? 
  user_id                 String
  created_at              DateTime          @default(now())
  user                    User              @relation(fields: [user_id], references: [id])  
  messages                ChatMessage[]
}

model ChatMessage {
  id                      String            @id @default(uuid())
  content                 String
  chatroom_id             String
  role                    ChatRole
  created_at              DateTime          @default(now())
  chatroom                ChatRoom          @relation(fields: [chatroom_id], references: [id])  
}

model Subscription {
  id                      String            @id @default(uuid())
  subscription_type       SubscriptionType
  subscription_status     SubscriptionStatus
  started_at              DateTime          @default(now())
  ended_at                DateTime?
  current_period_start    DateTime?
  current_period_end      DateTime?   
  stripe_subscription_id  String            @unique
  stripe_customer_id      String 
  stripe_price_id         String
  cancel_at_period_end    Boolean           @default(false)
  user_id                 String            @unique
  user                    User              @relation(fields: [user_id], references: [id]) 
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

enum SubscriptionType {
  BASIC
  PREMIUM
  BASIC_YEARLY
  PREMIUM_YEARLY
}

enum ChatRole {
  USER
  ASSISTANT
}

enum VatReportPeriod {
  MONTHLY
  YEARLY
  Q1
  Q2
  Q3
  Q4
}

enum ReceiptType {
  INCOME
  EXPENSE
}

enum CategoryType {
  TOIMISTOKULUT
  MATKAKULUT
  EDUSTUSKULUT
  ATERIA
  MARKKINOINTI_JA_MAINONTA
  KALUSTO_JA_LAITTEET
  PALKKAKULUT_JA_PALKKIOT
  VUOKRA
  VAKUUTUKSET
  PUHELIN_JA_TIETOLIIKENNE
  OHJELMISTOT_JA_LISENSSIT
  KOULUTUS_JA_KURSSIT
  KIRJANPITO_JA_LAKIPALVELUT
  PANKKIKULUT
  AJONEUVOKULUT
  KOTITOIMISTON_KULUT
  YKSITYISOTOT
  MUUT_KULUT
  MYYNTI_TUOTTEET
  MYYNTI_PALVELUT
  MUUT_TULOT
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}