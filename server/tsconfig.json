    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["jest", "multer", "express"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
